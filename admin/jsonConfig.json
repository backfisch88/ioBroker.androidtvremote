{
  "type": "panel",
  "items": {
    "host": {
      "type": "text",
      "label": "IP-Adresse / Hostname",
      "help": "IP-Adresse oder Hostname des Android TV / Google TV",
      "newLine": true,
      "xs": 12,
      "md": 6,
      "lg": 6,
      "xl": 6,
      "sm": 6
    },
    "deviceName": {
      "type": "text",
      "label": "Anzeigename beim Pairing",
      "default": "ioBroker",
      "xs": 12,
      "md": 6,
      "lg": 6,
      "xl": 6,
      "sm": 6
    },
    "pairingPort": {
      "type": "number",
      "label": "Pairing-Port",
      "default": 6467,
      "min": 1,
      "max": 65535,
      "newLine": true,
      "xs": 12,
      "md": 4,
      "lg": 4,
      "xl": 4,
      "sm": 4
    },
    "remotePort": {
      "type": "number",
      "label": "Remote-Port",
      "default": 6466,
      "min": 1,
      "max": 65535,
      "xs": 12,
      "md": 4,
      "lg": 4,
      "xl": 4,
      "sm": 4
    },
    "reconnectSeconds": {
      "type": "number",
      "label": "Reconnect nach Sekunden",
      "default": 15,
      "min": 5,
      "max": 3600,
      "xs": 12,
      "md": 4,
      "lg": 4,
      "xl": 4,
      "sm": 4
    },
    "debugProtocol": {
      "type": "checkbox",
      "label": "Protokoll-Debug aktivieren",
      "default": false,
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "hint": {
      "type": "staticText",
      "text": "Beim ersten Start zeigt der Fernseher einen Pairing-Code. Diesen unter Objekte → androidtvremote.X → control → pairingCode eintragen. Danach wird das Zertifikat lokal gespeichert.",
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "enableCast": {
      "type": "checkbox",
      "label": "Cast-Medieninfos aktivieren",
      "default": true,
      "newLine": true,
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "castPollSeconds": {
      "type": "number",
      "label": "Cast-Abfrage alle Sekunden",
      "default": 5,
      "min": 3,
      "max": 60,
      "xs": 12,
      "md": 4,
      "lg": 4,
      "xl": 4,
      "sm": 4
    }
  },
  "i18n": true
}
